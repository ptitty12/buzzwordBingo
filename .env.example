# ---------------------------------------------------------------------------
# Jargon Watch — configuration
# Copy to .env and adjust. Every value has a working default for local dev.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Signing secret for session tokens. Left empty, the server generates one on first
# boot and saves it to .secret_key next to the database, so restarts do not sign
# everyone out. Set it explicitly in production — it belongs with your other secrets,
# and every worker in a multi-process deployment has to agree on it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# SQLite database file. Relative paths resolve against the process working directory,
# so prefer an absolute path in deployment. Use :memory: for a throwaway instance.
# Defaults to <repo>/server/data/jargon.db when unset.
# DATABASE_URL=/var/lib/jargon-watch/jargon.db

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# The admin credential. Administrators have no account — this PIN *is* the login,
# and it also gates the OpenAPI docs at /api/docs. Setting it empty disables the
# admin console entirely rather than leaving it open. Change it before deploying.
ADMIN_PIN=2165

# Serve /api/docs and /api/redoc behind HTTP Basic using ADMIN_PIN, so participants
# never stumble into the integration surface.
PROTECT_API_DOCS=true

# Require X-API-Key on POST /api/ingest.
INGEST_REQUIRE_KEY=true

# ---------------------------------------------------------------------------
# Word suggestions (LLM curator)
# ---------------------------------------------------------------------------

# Participants can propose new buzzwords; Claude decides whether each is jargon worth a
# square. Without a key the feature still works — suggestions queue for an admin
# to approve by hand instead of being auto-decided.
ANTHROPIC_API_KEY=

# Model used to judge submissions.
MODERATION_MODEL=claude-opus-5

# How many words one participant may propose per meeting.
SUGGESTIONS_PER_PARTICIPANT=10
