# ---------------------------------------------------------------------------
# Buzzword Bingo — configuration
# Copy to .env and adjust. Every value has a working default for local dev.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Signing secret for session tokens. MUST be set in production — otherwise a new
# one is generated per process and every session is invalidated on restart.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# SQLite database file. Relative paths resolve against the process working directory,
# so prefer an absolute path in deployment. Use :memory: for a throwaway instance.
# Defaults to <repo>/server/data/bingo.db when unset.
# DATABASE_URL=/var/lib/buzzword-bingo/bingo.db

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional PIN gating admin sign-in. Empty = admin console is open to anyone,
# which matches the no-passwords brief but is flagged in the UI.
ADMIN_PIN=

# Nicknames auto-granted admin on first sign-up (comma separated).
BOOTSTRAP_ADMINS=admin

# Require X-API-Key on POST /api/ingest.
INGEST_REQUIRE_KEY=true
